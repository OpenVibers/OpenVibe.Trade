# ═══════════════════════════════════════════════════════════════
# openvibe.trade — environment configuration (names only; never commit values)
# Copy to .env for development. Production: /etc/openvibe/trade.env (0600).
# Information only: there is no payment, brokerage or custody configuration, by design (ADR-025).
# ═══════════════════════════════════════════════════════════════

# Server
PORT=4860
HOST=127.0.0.1
NODE_ENV=development
# Public origin: canonical URLs, feeds, sitemaps and JSON-LD are built from it
BASE_URL=http://localhost:4860
# Proxy hops that set X-Forwarded-For (Cloudflare → nginx → Node = 2)
TRUST_PROXY=2

# SQLite database (production unit: /var/lib/openvibe-trade/trade.db)
TRADE_DB_PATH=./data/trade.db

# OpenVibe.Network — SSO (OAuth2), JWKS, client-credentials tokens
OV_NETWORK_URL=https://openvibe.network
OV_NETWORK_INTERNAL_URL=http://127.0.0.1:4000
# OAuth client `trade` (redirect https://openvibe.trade/auth/callback). The same client is Trade's
# service principal svc:trade for client-credentials grants (see README, "Grants").
OV_OAUTH_CLIENT_ID=trade
OV_OAUTH_CLIENT_SECRET=
# Production: https://openvibe.trade/auth/callback (default: BASE_URL + /auth/callback)
#OV_OAUTH_REDIRECT_URI=
# Cookies: Secure by default in production; set false for plain-http local development
#COOKIE_SECURE=false
# Signs the watchlist, alert and editor form tokens (CSRF). Unset: random per process.
#TRADE_FORM_SECRET=

# Editors (create instruments, write context, review AI drafts): Network subjects, comma-separated.
# Staff with staff.editorial.manage (Network admins) are editors too; this list is the product's own role.
TRADE_EDITORS=

# OpenVibe.Sources — the trade category (filings, market data feeds), read by cursor with the
# service token above (sources.item.read, sources.source.read). Off while the secret is unset.
OV_SOURCES_INTERNAL_URL=http://127.0.0.1:4720
#TRADE_SYNC_INTERVAL_MS=60000
#TRADE_SYNC_PAGE_LIMIT=200
#TRADE_SYNC_MAX_PAGES=20

# Freshness: the window for a source that reports none, and the age after which a monetary
# observation makes an instrument page noindex (stale_price)
#TRADE_DEFAULT_STALE_AFTER_SEC=10800
#TRADE_PRICE_MAX_AGE_SEC=86400
#TRADE_FRESHNESS_INTERVAL_MS=60000
# Indexability: minimum words of reviewed context before an instrument page may be indexed
#TRADE_GATE_MIN_WORDS=60

# OpenVibe.Events — the outbox relay runs only when EVENTS_URL and OV_OAUTH_CLIENT_SECRET are set
#EVENTS_URL=http://127.0.0.1:4300
#EVENTS_RELAY_INTERVAL_MS=2000
# Secret of the Events subscription (topic sources.*) that POSTs to /internal/events.
# Unset: the webhook answers 404 and the sync runs on its timer only.
#TRADE_EVENTS_WEBHOOK_SECRET=

# Background work (Sources sync + freshness); off: TRADE_WORKER=off
#TRADE_WORKER=on

# Browser origins that may call /api/v1 with a Bearer Network JWT
#API_CORS_ORIGINS=https://openvibe.network

# release.json (openvibe-shared/release): the deployed commit when git is not available
#RELEASE_COMMIT=
#MIN_CLIENT_RELEASE=
